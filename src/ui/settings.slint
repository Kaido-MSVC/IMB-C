import { Button, CheckBox, ComboBox, LineEdit, ScrollView } from "std-widgets.slint";
import { Theme, Caption, Heading } from "theme.slint";

export component SettingsWindow inherits Window {
    title: "IMB-C · " + root.labels[0];
    icon: @image-url("../../assets/app.png");
    preferred-width: 720px;
    preferred-height: 510px;
    min-width: 630px;
    min-height: 420px;
    background: Theme.surface;
    default-font-size: 14px;

    in property <[string]> words;
    in property <[string]> v14-words;
    in property <[string]> labels;
    in property <string> runtime-info;
    in property <string> output-path;
    in property <bool> busy;
    in property <bool> save-failed;
    in property <string> save-error;
    in property <string> iat-path;
    in property <string> iat-version;
    in property <string> iat-error;
    in property <bool> iat-probing;
    in property <bool> iat-checked;
    in-out property <int> language-index;
    in-out property <int> theme-index;
    in-out property <bool> notify;
    in-out property <bool> iat-enabled;
    property <int> page: 0;
    callback preferences-changed();
    callback clear-folders();
    callback choose-iat();
    callback reset-iat();
    callback probe-iat();
    callback show-licenses();
    callback show-diagnostics();
    callback show-help();
    callback dismiss();

    HorizontalLayout {
        Rectangle {
            width: max(174px, sidebar.min-width);
            background: Theme.canvas;
            sidebar := VerticalLayout {
                padding: 14px;
                spacing: 8px;
                Heading { text: root.labels[0]; height: 42px; vertical-alignment: center; }
                for section[index] in [root.labels[13], root.labels[14], root.labels[15], root.labels[16]]: Button {
                    text: section;
                    height: Theme.control;
                    primary: root.page == index;
                    clicked => { root.page = index; }
                }
                Rectangle { vertical-stretch: 1; }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            padding: Theme.gutter;
            spacing: Theme.gap;
            Heading {
                text: [root.labels[13], root.labels[14], root.labels[15], root.labels[16]][root.page];
                font-size: 22px;
            }
            Rectangle { height: 1px; background: Theme.outline; }
            if root.page == 0: ScrollView {
                vertical-stretch: 1;
                horizontal-scrollbar-policy: always-off;
                VerticalLayout {
                    spacing: Theme.gap;
                    Text { text: root.words[28]; }
                    ComboBox {
                        model: [root.words[29], root.words[30], root.words[31]];
                        current-index <=> root.theme-index;
                        accessible-label: root.words[28];
                        height: Theme.control;
                        selected => { root.preferences-changed(); }
                    }
                    Text { text: root.words[27]; }
                    ComboBox {
                        model: ["繁體中文", "简体中文", "English", "日本語"];
                        current-index <=> root.language-index;
                        accessible-label: root.words[27];
                        height: Theme.control;
                        enabled: !root.busy;
                        selected => { root.preferences-changed(); }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }
            if root.page == 1: ScrollView {
                vertical-stretch: 1;
                horizontal-scrollbar-policy: always-off;
                VerticalLayout {
                    spacing: Theme.gap;
                    CheckBox {
                        text: root.words[44];
                        checked <=> root.notify;
                        toggled => { root.preferences-changed(); }
                    }
                    Caption { text: root.labels[18]; }
                    Text { text: root.labels[8]; font-weight: 600; }
                    Caption { text: root.labels[19]; }
                    LineEdit {
                        text: root.output-path;
                        placeholder-text: root.words[14];
                        accessible-label: root.labels[8];
                        read-only: true;
                    }
                    HorizontalLayout {
                        Button {
                            text: root.v14-words[4];
                            enabled: !root.busy;
                            clicked => { root.clear-folders(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }
            if root.page == 2: ScrollView {
                vertical-stretch: 1;
                horizontal-scrollbar-policy: always-off;
                VerticalLayout {
                    spacing: 9px;
                    CheckBox {
                        text: root.labels[20];
                        checked <=> root.iat-enabled;
                        enabled: !root.busy;
                        toggled => { root.preferences-changed(); }
                    }
                    LineEdit {
                        text: root.iat-path;
                        placeholder-text: root.v14-words[7];
                        accessible-label: root.labels[21];
                        read-only: true;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Button {
                            text: root.v14-words[6];
                            enabled: !root.busy && !root.iat-probing;
                            clicked => { root.choose-iat(); }
                        }
                        Button {
                            text: root.labels[22];
                            enabled: !root.busy && !root.iat-probing && root.iat-path != "";
                            clicked => { root.reset-iat(); }
                        }
                        Button {
                            text: root.labels[23];
                            enabled: !root.busy && !root.iat-probing;
                            clicked => { root.probe-iat(); }
                        }
                    }
                    Text {
                        text: root.iat-probing ? root.labels[24] : !root.iat-checked ? root.labels[25]
                            : root.iat-version != "" ? root.labels[26] + " · iat " + root.iat-version : root.labels[27];
                        font-weight: 600;
                        wrap: word-wrap;
                    }
                    if root.iat-error != "": Caption { text: root.iat-error; }
                    Caption { text: root.labels[28]; }
                    Caption { text: root.labels[29]; }
                    Rectangle { vertical-stretch: 1; }
                }
            }
            if root.page == 3: ScrollView {
                vertical-stretch: 1;
                horizontal-scrollbar-policy: always-off;
                VerticalLayout {
                    spacing: Theme.gap;
                    HorizontalLayout {
                        spacing: 8px;
                        Button { text: root.labels[30]; height: Theme.control; clicked => { root.show-licenses(); } }
                        Button { text: root.words[52]; height: Theme.control; clicked => { root.show-diagnostics(); } }
                    }
                    Button { text: root.labels[32]; height: Theme.control; clicked => { root.show-help(); } }
                    Text { text: root.runtime-info; wrap: word-wrap; }
                    Caption { text: root.labels[31]; }
                    Rectangle { vertical-stretch: 1; }
                }
            }
            Rectangle { height: 1px; background: Theme.outline; }
            HorizontalLayout {
                spacing: 8px;
                Caption {
                    text: root.save-failed ? root.words[32] + " " + root.save-error : root.labels[17];
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                if root.save-failed: Button { text: root.labels[33]; clicked => { root.preferences-changed(); } }
                Button { text: root.labels[34]; height: Theme.control; clicked => { root.dismiss(); } }
            }
        }
    }
}
